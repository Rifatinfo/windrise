model Order {
  id String @id @default(cuid())

  userId        String? // optional for guest users
  user          User?   @relation(fields: [userId], references: [id])
  orderNo       String  @unique
  name          String
  state         String
  phone         String
  address       String
  orderNote     String?
  checkoutEmail String?

  billingName    String?
  billingPhone   String?
  billingEmail   String?
  billingState   String?
  billingAddress String?

  subtotal    Float
  totalAmount Float

  invoiceUrl String?

  orderStatus    OrderStatus   @default(PLACED)
  // Both follow orderStatus while null. An admin picking a value from the
  // Shipment / After-Sales dropdowns stores an override here, which is
  // cleared again the next time the order status moves.
  shipmentStatus   ShipmentStatus?
  afterSalesStatus AfterSalesStatus?
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentMethod  PaymentMethod
  deliveryCharge Decimal?
  deliveryType   DeliveryType?
  items          OrderItem[]

  payment Payment? @relation("OrderPayment")

  couponId       String?
  coupon         Coupon? @relation(fields: [couponId], references: [id])
  discountAmount Float   @default(0)

  return OrderReturn?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  productName String
  price       Float
  quantity    Int
  total       Float

  color        String?
  size         String?
  sku          String?
  variantId    String?
  productImage String?

  // Relations
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  product Product  @relation(fields: [productId], references: [id])
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}
